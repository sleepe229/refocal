[submodule "flutter"]
	path = flutter
	url = https://github.com/flutter/flutter.git
[submodule "native/third_party/ncnn"]
	path = native/third_party/ncnn
	url = https://github.com/Tencent/ncnn.git
[submodule "native/third_party/libjpeg-turbo"]
	path = native/third_party/libjpeg-turbo
	url = https://github.com/libjpeg-turbo/libjpeg-turbo.git
[submodule "native/third_party/json"]
	path = native/third_party/json
	url = https://github.com/nlohmann/json.git
	shallow = true
[submodule "native/third_party/libpng"]
	path = native/third_party/libpng
	url = https://github.com/pnggroup/libpng.git
[submodule "native/third_party/libwebp"]
	path = native/third_party/libwebp
	url = https://github.com/webmproject/libwebp.git
