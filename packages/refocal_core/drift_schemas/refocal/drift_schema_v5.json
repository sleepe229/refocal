  "fixed_sql": [
    {
      "name": "assets",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"assets\" (\"id\" TEXT NOT NULL, \"inbox_path\" TEXT NOT NULL UNIQUE, \"width\" INTEGER NULL, \"height\" INTEGER NULL, \"created_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "recipes",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"recipes\" (\"id\" TEXT NOT NULL, \"schema\" INTEGER NOT NULL, \"json\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "history",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"history\" (\"id\" TEXT NOT NULL, \"asset_id\" TEXT NOT NULL REFERENCES assets (id), \"recipe_id\" TEXT NOT NULL REFERENCES recipes (id), \"job_id\" TEXT NOT NULL, \"result_uri\" TEXT NOT NULL, \"preview_path\" TEXT NOT NULL, \"width\" INTEGER NOT NULL, \"height\" INTEGER NOT NULL, \"model_ids\" TEXT NOT NULL, \"backend\" TEXT NOT NULL, \"duration_ms\" INTEGER NULL, \"created_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "queue_jobs",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"queue_jobs\" (\"id\" TEXT NOT NULL, \"asset_id\" TEXT NOT NULL REFERENCES assets (id), \"recipe_id\" TEXT NOT NULL REFERENCES recipes (id), \"state\" TEXT NOT NULL, \"position\" INTEGER NOT NULL, \"job_id\" TEXT NOT NULL UNIQUE, \"progress\" REAL NOT NULL DEFAULT 0.0, \"error_code\" TEXT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "model_packs",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"model_packs\" (\"id\" TEXT NOT NULL, \"version\" TEXT NOT NULL, \"category\" TEXT NOT NULL, \"path\" TEXT NOT NULL, \"size\" INTEGER NOT NULL, \"sha256\" TEXT NOT NULL, \"license_spdx\" TEXT NOT NULL, \"installed_at\" INTEGER NOT NULL, \"title\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "consents",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"consents\" (\"pack_id\" TEXT NOT NULL, \"pack_version\" TEXT NOT NULL, \"license_sha256\" TEXT NOT NULL, \"accepted_at\" INTEGER NOT NULL, PRIMARY KEY (\"pack_id\", \"license_sha256\"));"
        }
      ]
    },
    {
      "name": "manifest_state",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"manifest_state\" (\"id\" INTEGER NOT NULL, \"serial\" INTEGER NOT NULL, \"fetched_at\" INTEGER NOT NULL, \"json\" TEXT NOT NULL, PRIMARY KEY (\"id\"), CHECK (id = 1));"
        }
      ]
    },
    {
      "name": "benchmark_cache",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"benchmark_cache\" (\"key\" TEXT NOT NULL, \"json\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    },
